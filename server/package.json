{
  "name": "@fable-online/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Fable Online server: gateway, region channels, accounts, gold ledger, items, combat, spawns, loot, Realm chat, analytics.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx --disable-warning=ExperimentalWarning src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "bots": "tsx --disable-warning=ExperimentalWarning scripts/bots.ts",
    "ai-bench": "tsx --disable-warning=ExperimentalWarning scripts/ai-bench.ts",
    "extract": "tsx --disable-warning=ExperimentalWarning scripts/extract-defs.ts",
    "extract-town": "tsx --disable-warning=ExperimentalWarning scripts/extract-town.ts",
    "scoreboard-setup": "tsx --disable-warning=ExperimentalWarning scripts/scoreboard-setup.ts",
    "admin": "tsx --disable-warning=ExperimentalWarning scripts/admin.ts",
    "walkers": "tsx --disable-warning=ExperimentalWarning scripts/walkers.ts",
    "link-test": "tsx --disable-warning=ExperimentalWarning scripts/link-test.ts",
    "chat-bot": "tsx --disable-warning=ExperimentalWarning scripts/chat-bot.ts",
    "analytics-demo": "tsx --disable-warning=ExperimentalWarning scripts/analytics-demo.ts"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
