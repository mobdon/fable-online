; Fable Online settings. Copy to fable_online.ini next to fable_online.dll.
; Every line is optional.

[chat]
; The chat server, host:port. Run your own with server/chat (npm start).
server=127.0.0.1:7781
; Your hero name on a dev server (production logs in through the launcher instead).
; Empty = your Windows user name.
name=
; The key that opens the chat box, as a Windows virtual-key code. 13 = Enter.
open_key=13
enabled=1

[tags]
enabled=1
; 1 = also put a name tag on your own hero, to check placement when playing alone.
self=0
; How far above a hero's feet the tag floats, and which world axis is up (x, y or z).
height=2.1
up_axis=z
; Tags fade out between these distances.
full_distance=25
max_distance=55

[menu]
; 1 = show the Chapters of the Lost start-up menu over Fable's title screen.
enabled=1

[overlay]
enabled=1
font_px=15
chat_rows=8
; A mark at the centre of the view while you play: off, ring, dot or cross.
crosshair=off

[display]
; 1 = widescreen field of view: on screens wider than 4:3 you see more to the sides
; instead of a stretched or cropped picture (Hor+). Pick your screen's own resolution in
; Fable's Options too.
widescreen=1
; How wide the camera sees. 1 = Fable's own view; 1.1 = 10% more; 0.9 = 10% less.
fov_scale=1.0
; 1 = press F10 in game to write one frame's drawing calls to fable_online.log
; (used to fix the HUD stretching next).
frame_probe=0
; fullscreen = Fable's own exclusive full screen; windowed = a normal window;
; borderless = a window covering the whole monitor (quick alt-tab).
window=fullscreen
; desktop = your monitor's own resolution in 32-bit colour (Fable otherwise starts at
; 1024x768 in 16-bit colour from userst.ini); game = Fable's; or a size such as 2560x1440.
resolution=desktop
; max = the monitor's highest refresh rate at Fable's resolution; game = Fable's choice;
; or a number such as 144. Full screen only (a window follows the desktop). Experimental.
refresh=game
; game = Fable's own setting; on; off (more frames, may tear).
vsync=game
; 1 = keep the CPU at most one frame ahead of the graphics card, so the camera follows
; the mouse sooner. Experimental.
low_latency=0
; Mouse-look smoothing: off = the camera follows each mouse movement; game = Fable's own
; (averages the last few frames, so the view trails the mouse); or a number of frames.
mouse_smoothing=off
; 1 = Fable pulls the camera back to level while you walk (faster at high frame rates).
camera_auto_center=0
; 1 = keep Fable's camera assist, which turns and shifts the view on its own (toward a
; target, or the way the hero faces) and makes it sway while you turn. 0 = only the mouse
; turns the camera.
camera_assist=0
; 1 = turn the view with the mouse on every frame (experimental). Fable moves its camera only 15 times a
; second and blends the frames between, so without this the view trails the mouse.
camera_latch=0
; 1 = melee, spells and target lock pick the enemy you're looking at (the centre of the
; view) instead of the one in front of the hero. Experimental.
aim_at_crosshair=0
; HUD, minimap and menu size. auto = as big as on a 900-pixel-tall screen (x1.6 at 1440p,
; x2.4 at 4K); off = Fable's own size; or a factor such as 1.4. Experimental: menus
; aren't stretched to fill the screen yet.
hud_scale=off
