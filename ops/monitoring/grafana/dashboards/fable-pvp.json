    {
      "id": 74,
      "type": "barchart",
      "title": "Arena win rate by school (24h)",
      "description": "Balanced is about 50% each. The alert fires above 58% with 200+ results.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (school) (increase(fable_arena_results_total{result=\"win\",mode=~\"$mode\"}[1d])) / sum by (school) (increase(fable_arena_results_total{result=~\"win|loss\",mode=~\"$mode\"}[1d]))",
          "legendFormat": "{{school}}",
          "refId": "U",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.55
              },
              {
                "color": "red",
                "value": 0.58
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        },
        "xField": "school"
      }
    },
    {
      "id": 76,
      "type": "timeseries",
      "title": "Arena win rate by school over time",
