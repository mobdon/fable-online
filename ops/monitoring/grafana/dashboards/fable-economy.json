{
  "uid": "fable-economy",
  "title": "Fable Online: Economy",
  "tags": [
    "fable-online"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "query": {
          "query": "label_values(fable_players_online, region)",
          "refId": "region"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "fable-online"
      ],
      "asDropdown": false,
      "title": "Fable",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
