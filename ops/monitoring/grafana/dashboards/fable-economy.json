    {
      "id": 35,
      "type": "stat",
      "title": "Ledger vs DB drift",
      "description": "Sum of all balances in the DB minus what the ledger says should exist. Anything but 0 means gold moved off-ledger (a dupe or a direct DB edit).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "fable_gold_supply_db - fable_gold_supply_ledger",
          "legendFormat": "",
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 37,
      "type": "stat",
      "title": "Net gold / hour",
      "description": "Minted minus burned. Positive means inflation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(fable_gold_minted_total[1h])) - sum(rate(fable_gold_burned_total[1h]))) * 3600",
          "legendFormat": "",
          "refId": "J",
          "instant": true,
          "range": false,
          "format": "time_series"
